MODULE: themes
FILES: app/api/theme.py, app/schemas/theme.py, app/services/theme.py, app/repositories/theme.py
RESPONSIBILITY: 题材查询 API 端点，提供分页列表、详情、搜索、排名、分类和关联股票接口
DEPENDENCIES:
- uses: fastapi: API 路由框架
- uses: sqlalchemy: 异步数据库查询
- uses: pydantic: 请求/响应数据验证
SUBDIRS:
- api: api/theme.py
- schemas: schemas/theme.py
- services: services/theme.py
- repositories: repositories/theme.py
