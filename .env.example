# TradingThemesGod Docker Compose 环境变量

# 数据库配置
MYSQL_ROOT_PASSWORD=your_password_here
MYSQL_DATABASE=trading_themes
DB_PORT=3306

# 后端配置
APP_PORT=8000
APP_ENV=production
APP_DEBUG=false

# 前端配置
FRONTEND_PORT=80

# CORS 配置（JSON 数组）
CORS_ORIGINS=["http://localhost"]

# JWT 认证（生产环境务必修改为随机长字符串）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
