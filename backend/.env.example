# TradingThemesGod Backend Environment Variables

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trading_themes
DB_USER=root
DB_PASSWORD=your_password_here

# CORS 配置（逗号分隔）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 代理配置（可选）
PROXY_ENABLED=false
PROXY_URL=http://127.0.0.1:7890

# 自动采集配置
SCRAPER_AUTO_ENABLED=true
SCRAPER_INTERVAL_SECONDS=21600
THEME_INSIGHT_AUTO_ENABLED=true
THEME_INSIGHT_INTERVAL_SECONDS=3600
THEME_INSIGHT_BATCH_SIZE=10
THEME_PROFILE_MAX_AGE_DAYS=7

# 雪球登录 Cookie（可选；未配置时仅雪球来源不可用）
XUEQIU_COOKIE=

# Tushare Pro（可选）
# 启用后且配置 token 才参与全量竞速
TUSHARE_ENABLED=false
TUSHARE_TOKEN=
# 自定义 Pro 地址，留空用官方默认 http://api.tushare.pro
TUSHARE_API_URL=
# 概念接口尝试顺序（逗号分隔）：concept | ths_index | dc_index
TUSHARE_CONCEPT_APIS=concept,ths_index,dc_index
TUSHARE_CONCEPT_SRC=ts
TUSHARE_THS_INDEX_TYPE=N
TUSHARE_THS_INDEX_EXCHANGE=A
TUSHARE_MAX_RETRIES=3

# 模型凭据加密密钥。生产环境应设置 Fernet key；留空时本地生成 .model-secret.key
MODEL_SECRET_KEY=

# JWT 认证（生产环境务必修改）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
