# TradingThemesGod Backend Environment Variables

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trading_themes
DB_USER=root
DB_PASSWORD=your_password_here

# CORS 配置（逗号分隔）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 代理配置（可选）
PROXY_ENABLED=false
PROXY_URL=http://127.0.0.1:7890
